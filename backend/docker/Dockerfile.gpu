# GPU consumer image (BE-M1-D / YU-56) — OPTIONAL.
#
# Default deployment uses the CPU image (docker/Dockerfile) where the consumer
# falls back to the stub detector. This image adds CUDA + torch + ultralytics so
# the consumer runs real YOLO on an NVIDIA GPU (e.g. RTX 2060, compute 7.5).
#
# Opt in via:  docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
# Build context is the REPO ROOT (same as the base image).
#
# CUDA 12.1 runtime + cuDNN matches the torch cu121 wheels below and supports
# Turing (RTX 20xx) through Ada. Set YOLO_DEVICE=cuda in .env when using this.

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS gpu

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    ca-certificates curl \
    libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/* \
  && ln -sf /usr/bin/python3 /usr/local/bin/python

RUN pip install --upgrade pip \
 && pip install \
      "flask>=3.0,<4.0" \
      "flask-sock>=0.7" \
      "redis>=5.0,<6.0" \
      "prometheus-client>=0.20" \
      "pymysql>=1.1" \
      "minio>=7.2" \
      "pyyaml>=6.0" \
      "opencv-python-headless>=4.9" \
      "numpy>=1.26" \
 && pip install --index-url https://download.pytorch.org/whl/cu121 \
      "torch" "torchvision" \
 && pip install "ultralytics>=8.2"

COPY backend/app ./app
COPY backend/sql ./sql
COPY backend/README.md ./

EXPOSE 9102
CMD ["python", "-m", "app.workers.consumer"]
