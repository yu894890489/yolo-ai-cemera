# Backend environment — copy to .env and edit on the deploy host.
# Do NOT commit real credentials.

# --- Redis (shared with BE-M0-S5) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- MySQL (S2 schema, BE-M0-S5 environment) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=yolo
MYSQL_PASSWORD=change-me
MYSQL_DB=yolo_vlm

# --- MinIO (shared with BE-M0-S5) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_ALARMS=alarms
MINIO_BUCKET_RECORDINGS=recordings
MINIO_SECURE=false

# --- Worker metrics ports ---
PRODUCER_METRICS_PORT=9101
CONSUMER_METRICS_PORT=9102
SAVER_METRICS_PORT=9103

# --- Flask main process ---
FLASK_PORT=8000
FLASK_SECRET_KEY=change-me

# --- YOLO ---
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu

# --- Stream / consumer group names ---
STREAM_FRAME_PREFIX=frame:
STREAM_ALARM_RAW=alarm:raw
STREAM_ALARM_PUSHED=alarm:pushed
CONSUMER_GROUP_CONSUMER=g:consumer
CONSUMER_GROUP_SAVER=g:saver
