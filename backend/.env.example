# Backend environment — copy to .env and fill the two secret groups marked
# "FILL ME" below. Everything else is pre-filled for the shared environment
# (192.168.10.83, YU-39). Do NOT commit real credentials.
#
#   cp .env.example .env
#   # edit VLM_API_KEY + MINIO_ACCESS_KEY/SECRET_KEY
#   docker compose up -d --build

# --- Redis (started by this compose) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- MySQL (shared env, S2 schema; migrate job creates the tables) ---
MYSQL_HOST=192.168.10.83
MYSQL_PORT=3306
MYSQL_USER=yolo
MYSQL_PASSWORD=change-me
MYSQL_DB=yolo_vlm

# --- MinIO (shared env) — FILL ME: AK/SK ---
MINIO_ENDPOINT=192.168.10.83:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_ALARMS=alarms
MINIO_BUCKET_RECORDINGS=recordings
MINIO_SECURE=false

# --- MediaMTX (shared env) — HLS preview / WHEP / RTSP ingest ---
# Flask returns preview_url as ${MEDIAMTX_HLS_BASE_URL}/{task_id}/index.m3u8.
MEDIAMTX_HLS_BASE_URL=http://192.168.10.83:18888
MEDIAMTX_WHEP_BASE_URL=http://192.168.10.83:18889
MEDIAMTX_RTSP_BASE_URL=rtsp://192.168.10.83:11935

# --- Chroma (shared env, reserved for M2 retrieval) ---
CHROMA_ENDPOINT=http://192.168.10.83:18003

# --- Worker metrics ports ---
PRODUCER_METRICS_PORT=9101
CONSUMER_METRICS_PORT=9102
SAVER_METRICS_PORT=9103

# --- Flask main process (8010 to avoid the occupied 8000) ---
FLASK_PORT=8010
FLASK_SECRET_KEY=change-me

# --- Frontend runtime config (injected as <meta> by Flask page shells) ---
# Empty api-base => same-origin (Flask serves both API and pages). Set only for
# cross-origin dev. minio-base builds screenshot URLs in the alarm list.
FRONTEND_API_BASE=
FRONTEND_MINIO_BASE=http://192.168.10.83:19000

# --- YOLO (CPU stub by default; set cuda with docker-compose.gpu.yml) ---
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu

# --- Cloud VLM (small_crop path; endpoint rows live in vlm_endpoints) ---
# FILL ME: bearer token for the OpenAI-compatible vision endpoint. Empty leaves
# the small_only path (VLM judgment disabled).
VLM_API_KEY=

# --- API / Saver repository backend: "mysql" (default) or "memory" ---
# mysql => Flask + Saver share durable storage so /api/alarms reads Saver writes.
API_REPO=mysql

# --- Stream / consumer group names ---
STREAM_FRAME_PREFIX=frame:
STREAM_ALARM_RAW=alarm:raw
STREAM_ALARM_PUSHED=alarm:pushed
CONSUMER_GROUP_CONSUMER=g:consumer
CONSUMER_GROUP_SAVER=g:saver
